# Kopieer naar .env en vul in. .env staat in .gitignore.

# --- Homey Pro ---------------------------------------------------------
# API-key maak je aan in de Homey Web App: Settings -> API Keys.
# Geef 'm minimaal leesrechten op devices, zones en flows.
HOMEY_HOST=192.168.1.10
HOMEY_API_KEY=

# --- Somfy TaHoma ------------------------------------------------------
# cloud | local
TAHOMA_MODE=cloud

# cloud: je gewone TaHoma-account
TAHOMA_USERNAME=
TAHOMA_PASSWORD=
TAHOMA_SERVER=SOMFY_EUROPE

# local: developer mode aanzetten in de TaHoma-app, dan token genereren.
# Host is de gateway-PIN als hostname, of gewoon het IP-adres.
TAHOMA_LOCAL_HOST=gateway-1234-5678-9012.local
TAHOMA_LOCAL_TOKEN=
TAHOMA_VERIFY_SSL=true

# --- Apple TV ----------------------------------------------------------
# Vul in na 'make appletv' (die scant en toont de identifiers).
APPLETV_ID=
APPLETV_NAAM=Apple TV woonkamer
