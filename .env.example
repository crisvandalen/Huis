# Kopieer naar .env en vul in. .env staat in .gitignore.

# --- Homey Pro ---------------------------------------------------------
# API-key maak je aan in de Homey Web App: Settings -> API Keys.
# Geef 'm minimaal leesrechten op devices, zones en flows.
HOMEY_HOST=192.168.1.10
HOMEY_API_KEY=
# Optioneel: cloudroute van Athom, werkt ook buitenshuis (VPS). Het cloud-id
# is de lange code in de URL van my.homey.app (my.homey.app/homeys/<dit-id>/...).
# Op een VPS: HOMEY_HOST leeg laten en alleen dit invullen.
HOMEY_CLOUD_ID=

# --- Somfy TaHoma ------------------------------------------------------
# cloud | local
TAHOMA_MODE=cloud

# cloud: je gewone TaHoma-account
TAHOMA_USERNAME=
TAHOMA_PASSWORD=
TAHOMA_SERVER=SOMFY_EUROPE

# local: developer mode aanzetten in de TaHoma-app, dan token genereren.
# Host is de gateway-PIN als hostname, of gewoon het IP-adres.
TAHOMA_LOCAL_HOST=gateway-1234-5678-9012.local
TAHOMA_LOCAL_TOKEN=
TAHOMA_VERIFY_SSL=true

# --- Athom-cloud OAuth (alleen nodig voor de Ring-cameralog) -----------
# Aanvragen via https://tools.developer.homey.app → API Projects.
# Daarna eenmalig: make cloud-auth
HOMEY_CLIENT_ID=
HOMEY_CLIENT_SECRET=

# --- Router (Teltonika, voor het Netwerk-tabblad) ----------------------
# Alleen thuis bereikbaar; draai `make router` op de Mac.
ROUTER_HOST=192.168.1.1
ROUTER_USER=admin
ROUTER_PASS=

# --- VPS (dashboard publiceren) ---------------------------------------
# Doel voor 'make publiceer': ssh-doel + map waar de webserver uit leest.
# Voorbeeld: VPS_DOEL=cris@mijnvps.nl:/var/www/huis/
VPS_DOEL=

# --- Apple TV ----------------------------------------------------------
# Vul in na 'make appletv' (die scant en toont de identifiers).
APPLETV_ID=
APPLETV_NAAM=Apple TV woonkamer
